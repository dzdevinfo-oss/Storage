<?xml version="1.0" encoding="utf-8"?>
<ru.kslabs.ksweb.editor.view.MyScrollView
    android:id="@id/scrollView"
    android:background="@color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@id/mainEditContainer"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ru.kslabs.ksweb.editor.view.MyEditText
            android:textSize="14.0sp"
            android:gravity="top"
            android:layout_gravity="top"
            android:id="@id/mainEdit"
            android:background="@color/white"
            android:layout_width="fill_parent"
            android:layout_height="200.0dip"
            android:inputType="textVisiblePassword|textMultiLine|textNoSuggestions"
            android:imeOptions="flagNoExtractUi"
            android:hardwareAccelerated="true">
            <requestFocus />
        </ru.kslabs.ksweb.editor.view.MyEditText>
    </LinearLayout>
</ru.kslabs.ksweb.editor.view.MyScrollView>