<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/header"
        android:background="@drawable/card_header_shadow"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="2.0">
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@id/headerContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:id="@id/cardTitleText"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:singleLine="true"
                    android:textIsSelectable="false"
                    android:layout_marginStart="15.0dip" />
            </LinearLayout>
            <Button
                android:id="@id/errorBtn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginRight="10.0dip"
                android:text="@string/error"
                android:layout_marginStart="10.0dip"
                android:layout_marginEnd="10.0dip"
                style="@style/ButtonRedStyle" />
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center"
            android:padding="5.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@id/enableServersBtn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7.0dip"
                android:layout_marginTop="4.0dip"
                android:layout_marginRight="7.0dip"
                android:layout_marginBottom="3.0dip" />
            <TextView
                android:textSize="18.0sp"
                android:id="@id/enableMarker"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3.0dip"
                android:layout_marginRight="20.0dip"
                android:text="Enable Marker"
                android:singleLine="true"
                android:textIsSelectable="false"
                android:layout_marginStart="3.0dip"
                android:layout_marginEnd="20.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/cardContainer"
        android:paddingLeft="20.0dip"
        android:paddingRight="20.0dip"
        android:paddingBottom="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.0dip"
        android:layout_below="@id/header"
        android:paddingStart="20.0dip"
        android:paddingEnd="20.0dip" />
</merge>