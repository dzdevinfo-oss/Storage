<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/documentRootPathContainer"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@id/chooseExtensionFolderBtn"
                android:layout_width="52.0dip"
                android:layout_height="40.0dip"
                android:layout_marginTop="5.0dip"
                android:layout_marginRight="10.0dip"
                android:text="+"
                style="@style/ButtonStyle" />
            <EditText
                android:id="@id/pathToExtensionEditTxt"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minWidth="300.0dip"
                android:hint="@string/pathToExtensionPack"
                android:ems="10"
                android:layout_toRightOf="@id/chooseExtensionFolderBtn"
                android:inputType="textNoSuggestions"
                style="@style/MainColorStyle" />
            <Button
                android:enabled="false"
                android:id="@id/installExtensionPackBtn"
                android:layout_width="wrap_content"
                android:layout_height="40.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="10.0dip"
                android:text="@string/installBtn"
                android:layout_below="@id/chooseExtensionFolderBtn"
                style="@style/ButtonStyle" />
            <Button
                android:id="@id/searchExtensionBtn"
                android:layout_width="wrap_content"
                android:layout_height="40.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="10.0dip"
                android:layout_marginBottom="10.0dip"
                android:text="@string/searchExtension"
                android:layout_toRightOf="@id/installExtensionPackBtn"
                android:layout_below="@id/chooseExtensionFolderBtn"
                style="@style/ButtonStyle" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@id/message_spv"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>