<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/RelativeLayout1"
    android:background="@color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@id/status"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:background="#fff0f0f0"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="end"
                android:id="@id/statusLineContainer"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@id/curLinePos"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@id/offsetPos"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/curLinePos"
                    android:layout_toEndOf="@id/curLinePos" />
                <TextView
                    android:id="@id/length"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/offsetPos"
                    android:layout_toEndOf="@id/offsetPos" />
                <TextView
                    android:id="@id/linesCount"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/length"
                    android:layout_toEndOf="@id/length" />
            </RelativeLayout>
            <HorizontalScrollView
                android:id="@id/fastSymbolContainerScrollView"
                android:background="@color/light_gray"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/statusLineContainer">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/fastSymbolContainer"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/emptyContainer"
        android:layout_width="fill_parent"
        android:layout_height="?actionBarSize" />
    <com.google.android.material.appbar.AppBarLayout
        android:id="@id/appBarLayout"
        android:fitsSystemWindows="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@id/myToolBar"
            android:background="@color/button"
            android:layout_width="fill_parent"
            android:layout_height="?actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />
        <com.google.android.material.tabs.TabLayout
            android:id="@id/editorTabsLayout"
            android:background="@color/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/white"
            app:tabMode="scrollable"
            app:tabPaddingEnd="25.0dip"
            app:tabPaddingStart="25.0dip"
            app:tabSelectedTextColor="@color/white"
            app:tabTextAppearance="@style/TabLayoutTextStyle" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/findReplaceContainer"
            android:background="@color/light_gray"
            android:padding="5.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/myToolBar">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginRight="10.0dip"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="10.0dip">
                    <EditText
                        android:textSize="14.0sp"
                        android:id="@id/findText"
                        android:layout_width="0.0px"
                        android:layout_height="wrap_content"
                        android:minWidth="120.0dip"
                        android:hint="@string/findText"
                        android:maxLines="1"
                        android:layout_weight="3.0"
                        android:inputType="textVisiblePassword|textMultiLine|textNoSuggestions"
                        android:imeOptions="flagNoExtractUi" />
                    <TextView
                        android:textSize="14.0sp"
                        android:gravity="center"
                        android:id="@id/foundTextStatusCount"
                        android:layout_width="0.0px"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:layout_weight="1.0" />
                    <EditText
                        android:textSize="14.0sp"
                        android:id="@id/replaceText"
                        android:layout_width="0.0px"
                        android:layout_height="wrap_content"
                        android:minWidth="120.0dip"
                        android:hint="@string/replaceText"
                        android:maxLines="1"
                        android:layout_weight="3.0"
                        android:inputType="textVisiblePassword|textMultiLine|textNoSuggestions"
                        android:imeOptions="flagNoExtractUi" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginTop="5.0dip"
                    android:layout_marginStart="10.0dip">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:id="@id/previousFoundBtn"
                            android:paddingLeft="10.0dip"
                            android:paddingRight="10.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="35.0dip"
                            style="@style/ButtonStyleGreen">
                            <ImageView
                                android:layout_width="24.0dip"
                                android:layout_height="24.0dip"
                                app:srcCompat="@drawable/ic_arrow_up" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@id/nextFoundBtn"
                            android:paddingLeft="10.0dip"
                            android:paddingRight="10.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="35.0dip"
                            android:layout_marginLeft="5.0dip"
                            android:layout_marginStart="5.0dip"
                            style="@style/ButtonStyleGreen">
                            <ImageView
                                android:layout_width="24.0dip"
                                android:layout_height="24.0dip"
                                app:srcCompat="@drawable/ic_arrow_down" />
                        </LinearLayout>
                        <TextView
                            android:gravity="center"
                            android:id="@id/replaceBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10.0dip"
                            android:text="@string/replaceBtn"
                            android:layout_marginStart="10.0dip"
                            style="@style/ButtonStyleGreen" />
                        <TextView
                            android:gravity="center"
                            android:id="@id/replaceAllBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10.0dip"
                            android:text="@string/replaceAllBtn"
                            android:layout_marginStart="10.0dip"
                            style="@style/ButtonStyleGreen" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@id/editorTabsPager"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/status"
        android:layout_below="@id/appBarLayout" />
</RelativeLayout>