<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <EditText
        android:id="@id/mainStoragePath"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.0dip"
        android:minWidth="300.0dip"
        android:hint="@string/storagePathHint"
        android:ems="10"
        android:inputType="textNoSuggestions"
        style="@style/MainColorStyle">
        <requestFocus />
    </EditText>
    <TextView
        android:textSize="16.0sp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20.0dip"
        android:text="@string/possibleStorages"
        android:textIsSelectable="false"
        style="@style/TextViewStyle" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/allowedPathsContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.0dip" />
    <TextView
        android:textSize="12.0sp"
        android:textColor="@color/btn_gray_txt_color"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15.0dip"
        android:layout_marginBottom="10.0dip"
        android:text="@string/youNeedToChangeSomePathsManually"
        android:lineSpacingMultiplier="1.3"
        android:textIsSelectable="false"
        android:layout_marginStart="15.0dip"
        style="@style/TextViewStyle" />
</LinearLayout>