<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <EditText
        android:id="@id/cmdEdTxt"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minWidth="300.0dip"
        android:hint="@string/cmdBeforeStartComponent"
        android:minLines="3"
        android:ems="10"
        android:inputType="textMultiLine|textNoSuggestions"
        style="@style/MainColorStyle">
        <requestFocus />
    </EditText>
    <TextView
        android:textSize="12.0sp"
        android:textColor="@color/btn_gray_txt_color"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="10.0dip"
        android:text="@string/addCmdBeforeStartComponentHint"
        android:layout_toRightOf="@id/folderIcon"
        android:layout_centerVertical="true"
        android:lineSpacingMultiplier="1.3"
        android:textIsSelectable="false"
        android:layout_marginStart="15.0dip"
        style="@style/TextViewStyle" />
</LinearLayout>